# local (default) or cloud; changing mode never silently moves local data
NEXT_PUBLIC_DATA_MODE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional, server-only; enables authenticated deletion of the caller’s account
SUPABASE_SERVICE_ROLE_KEY=
